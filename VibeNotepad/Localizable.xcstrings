    "Like Sublime Text: quit any time, your unsaved buffers come back next launch." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مثل Sublime Text: يمكنك إنهاء التطبيق في أي وقت، وستعود نصوصك غير المحفوظة عند التشغيل التالي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie in Sublime Text: Beende die App jederzeit, deine ungesicherten Texte sind beim nächsten Start wieder da."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Como en Sublime Text: sal cuando quieras y tus textos sin guardar volverán la próxima vez que abras la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comme dans Sublime Text : quittez à tout moment, vos textes non enregistrés reviennent au prochain lancement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sublime Text की तरह: कभी भी ऐप छोड़ें, आपका बिना सहेजा टेक्स्ट अगली बार खोलने पर वापस आ जाएगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seperti Sublime Text: keluar kapan saja, teks Anda yang belum disimpan akan kembali saat aplikasi dibuka lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Come in Sublime Text: esci quando vuoi, i buffer non salvati tornano al prossimo avvio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sublime Textのように、いつ終了しても未保存の内容は次回の起動時に復元されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sublime Text처럼 언제든 종료해도 저장하지 않은 내용이 다음 실행 때 복원됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seperti Sublime Text: keluar pada bila-bila masa dan teks anda yang belum disimpan akan kembali apabila app dibuka semula."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Net als in Sublime Text: je kunt de app op elk moment stoppen; je niet-bewaarde buffers komen bij de volgende start terug."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jak w Sublime Text: zakończ aplikację w dowolnej chwili, a niezachowany tekst wróci przy następnym uruchomieniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Como no Sublime Text: encerre quando quiser e seus textos não salvos voltam na próxima vez que você abrir o app."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Как в Sublime Text: выходите когда угодно — несохранённый текст вернётся при следующем запуске."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เหมือน Sublime Text: ออกได้ทุกเมื่อ แล้วข้อความที่ยังไม่ได้บันทึกจะกลับมาเมื่อเปิดแอปครั้งถัดไป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sublime Text gibi: istediğiniz zaman çıkın, kaydedilmemiş metinleriniz bir sonraki açılışta geri gelir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Як у Sublime Text: виходьте з програми будь-коли, незбережений текст повернеться під час наступного запуску."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giống Sublime Text: bạn có thể thoát bất cứ lúc nào, nội dung chưa lưu sẽ quay lại vào lần mở sau."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "类似 Sublime Text：可随时退出，下次启动时会恢复未保存的内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "和 Sublime Text 一樣：隨時都可以結束，未儲存的內容會在下次啟動時回來。"
          }
        }
      }
    },
