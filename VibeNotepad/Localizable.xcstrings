    "Reverting loads the file from disk again. Your unsaved changes will be lost." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يؤدي الرجوع إلى تحميل الملف من القرص مرة أخرى. ستفقد تغييراتك غير المحفوظة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Zurücksetzen wird die Datei wieder vom Datenträger geladen. Deine ungesicherten Änderungen gehen verloren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al restaurar, el archivo se vuelve a cargar desde el disco. Perderás los cambios sin guardar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le retour à la version enregistrée recharge le fichier depuis le disque. Vos modifications non enregistrées seront perdues."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वापस लाने पर फ़ाइल डिस्क से दोबारा लोड होती है। आपके बिना सहेजे बदलाव खो जाएँगे।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengembalikan akan memuat berkas dari disk lagi. Perubahan Anda yang belum disimpan akan hilang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il ripristino carica di nuovo il file dal disco. Le modifiche non salvate andranno perse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "戻すと、ファイルがディスクから再度読み込まれます。未保存の変更は失われます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "복귀하면 파일을 디스크에서 다시 불러옵니다. 저장하지 않은 변경 사항은 사라집니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengembalikan akan memuatkan fail daripada cakera sekali lagi. Perubahan anda yang belum disimpan akan hilang."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het bestand wordt opnieuw van schijf geladen. Je niet-bewaarde wijzigingen gaan verloren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przywrócenie wczytuje plik z dysku jeszcze raz. Niezachowane zmiany zostaną utracone."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reverter carrega o arquivo do disco novamente. Suas alterações não salvas serão perdidas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При возврате файл снова загружается с диска. Несохранённые изменения будут потеряны."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การแปลงกลับจะโหลดไฟล์จากดิสก์อีกครั้ง การเปลี่ยนแปลงที่ยังไม่ได้บันทึกจะสูญหาย"
