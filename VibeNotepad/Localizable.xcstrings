    "Reopening loads the file from disk again. Your unsaved changes will be lost." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تؤدي إعادة الفتح إلى تحميل الملف من القرص مرة أخرى. ستفقد تغييراتك غير المحفوظة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim erneuten Öffnen wird die Datei wieder vom Datenträger geladen. Deine ungesicherten Änderungen gehen verloren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al reabrir, el archivo se vuelve a cargar desde el disco. Perderás los cambios sin guardar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La réouverture recharge le fichier depuis le disque. Vos modifications non enregistrées seront perdues."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फिर से खोलने पर फ़ाइल डिस्क से दोबारा लोड होती है। आपके बिना सहेजे बदलाव खो जाएँगे।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Membuka ulang akan memuat berkas dari disk lagi. Perubahan Anda yang belum disimpan akan hilang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La riapertura carica di nuovo il file dal disco. Le modifiche non salvate andranno perse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開き直すと、ファイルがディスクから再度読み込まれます。未保存の変更は失われます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다시 열면 파일을 디스크에서 다시 불러옵니다. 저장하지 않은 변경 사항은 사라집니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Membuka semula akan memuatkan fail daripada cakera sekali lagi. Perubahan anda yang belum disimpan akan hilang."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het bestand wordt opnieuw van schijf geladen. Je niet-bewaarde wijzigingen gaan verloren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponowne otwarcie wczytuje plik z dysku jeszcze raz. Niezachowane zmiany zostaną utracone."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reabrir carrega o arquivo do disco novamente. Suas alterações não salvas serão perdidas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При повторном открытии файл снова загружается с диска. Несохранённые изменения будут потеряны."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การเปิดใหม่จะโหลดไฟล์จากดิสก์อีกครั้ง การเปลี่ยนแปลงที่ยังไม่ได้บันทึกจะสูญหาย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeniden açmak dosyayı diskten tekrar yükler. Kaydedilmemiş değişiklikleriniz kaybolacak."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повторне відкриття завантажить файл з диска ще раз. Ваші незбережені зміни буде втрачено."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Việc mở lại sẽ tải tệp từ ổ đĩa một lần nữa. Các thay đổi chưa lưu của bạn sẽ bị mất."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重新打开会再次从磁盘载入该文件。你尚未保存的更改将会丢失。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重新打開會再次從磁碟載入檔案，你尚未儲存的變更將會遺失。"
          }
        }
      }
    },
