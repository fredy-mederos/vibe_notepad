    "Choose a folder to open as a project. With nothing selected, “%@” opens." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر مجلدًا لفتحه كمشروع. إذا لم تحدد شيئًا، فسيُفتح «%@»."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle einen Ordner, der als Projekt geöffnet werden soll. Ohne Auswahl wird „%@“ geöffnet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige una carpeta para abrirla como proyecto. Si no seleccionas nada, se abre «%@»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez un dossier à ouvrir comme projet. Si rien n’est sélectionné, « %@ » s’ouvre."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रोजेक्ट के रूप में खोलने के लिए कोई फ़ोल्डर चुनें। कुछ भी न चुनने पर “%@” खुलेगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih folder untuk dibuka sebagai proyek. Jika tidak ada yang dipilih, “%@” akan dibuka."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli una cartella da aprire come progetto. Se non selezioni nulla, si apre “%@”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロジェクトとして開くフォルダを選択してください。何も選択しない場合は、「%@」が開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프로젝트로 열 폴더를 선택하세요. 아무것도 선택하지 않으면 “%@” 폴더가 열립니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih folder untuk dibuka sebagai projek. Jika tiada yang dipilih, “%@” akan dibuka."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies een map om als project te openen. Als je niets selecteert, wordt “%@” geopend."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
