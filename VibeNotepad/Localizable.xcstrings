    "Also the length of File → Open Recent. Filtering the sidebar searches the last 100 files." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحدد أيضًا طول القائمة ملف → فتح ملف أخير. تبحث تصفية الشريط الجانبي في آخر 100 ملف."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gilt auch für die Länge von Ablage → Zuletzt geöffnet. Beim Filtern der Seitenleiste werden die letzten 100 Dateien durchsucht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "También determina cuántos archivos muestra Archivo → Abrir recientes. Al filtrar la barra lateral, se busca entre los últimos 100 archivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Détermine aussi la longueur de Fichier → Ouvrir récent. Le filtre de la barre latérale porte sur les 100 derniers fichiers."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इससे फ़ाइल → हाल की फ़ाइलें खोलें की लंबाई भी तय होती है। साइडबार को फ़िल्टर करने पर पिछली 100 फ़ाइलों में खोजा जाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Juga menentukan panjang daftar Berkas → Buka Terbaru. Memfilter bar samping mencari di 100 berkas terakhir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stabilisce anche la lunghezza di File → Apri recenti. Il filtro della barra laterale cerca negli ultimi 100 file."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「ファイル → 最近使った項目を開く」の項目数にも反映されます。サイドバーのフィルタは、最近使った100ファイルを対象に検索します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "파일 → 최근 항목 열기에 표시되는 항목 수에도 적용됩니다. 사이드바에서 필터링하면 최근 파일 100개를 검색합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Juga menentukan panjang Fail → Buka Terbaharu Diguna. Menapis bar sisi akan mencari dalam 100 fail terbaharu."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bepaalt ook hoeveel bestanden Archief → Open recente bestanden toont. Als je de zijbalk filtert, worden de laatste 100 bestanden doorzocht."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Określa też długość listy Plik → Otwórz ostatnie. Filtrowanie paska bocznego przeszukuje 100 ostatnich plików."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Também define quantos itens aparecem em Arquivo → Abrir recente. Ao filtrar a barra lateral, a busca considera os últimos 100 arquivos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Определяет также длину меню Файл → Открыть недавние. Фильтр в боковом меню ищет среди последних 100 файлов."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เป็นความยาวของ ไฟล์ → เปิดล่าสุด ด้วย การกรองแถบด้านข้างจะค้นหาใน 100 ไฟล์ล่าสุด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dosya → Son Kullanılanları Aç menüsünün uzunluğunu da belirler. Kenar çubuğunu filtrelemek son 100 dosyada arar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Також задає довжину меню Файл → Відкрити нещодавні. Фільтр на бічній панелі шукає серед останніх 100 файлів."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cũng là độ dài của danh sách Tệp → Mở gần đây. Khi lọc thanh bên, 100 tệp gần nhất sẽ được tìm kiếm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同时决定“文件 → 打开最近使用”的长度。在边栏中筛选时，会搜索最近使用的 100 个文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同時也是「檔案 → 打開最近使用的項目」的項目數量。篩選側邊欄時，會搜尋最近 100 個檔案。"
          }
        }
      }
    },
    "An optimized build, as installed by make install or downloaded from GitHub." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بناء محسَّن، مثل الذي يثبّته make install أو الذي يُنزَّل من GitHub."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein optimierter Build, wie ihn make install installiert oder wie er von GitHub heruntergeladen wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una compilación optimizada, como la que instala make install o la que se descarga de GitHub."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un build optimisé, tel qu’installé par make install ou téléchargé depuis GitHub."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक ऑप्टिमाइज़्ड बिल्ड, जैसा make install से इंस्टॉल होता है या GitHub से डाउनलोड किया जाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Build yang dioptimalkan, seperti yang diinstal oleh make install atau diunduh dari GitHub."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una build ottimizzata, come quella installata con make install o scaricata da GitHub."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "make installでインストールされたか、GitHubからダウンロードした、最適化されたビルドです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "make install로 설치했거나 GitHub에서 다운로드한 최적화 빌드입니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Binaan yang dioptimumkan, seperti yang dipasang oleh make install atau dimuat turun daripada GitHub."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een geoptimaliseerde build, zoals geïnstalleerd door make install of gedownload van GitHub."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoptymalizowana kompilacja, taka jak instalowana przez make install lub pobierana z GitHub."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma compilação otimizada, como a instalada com make install ou baixada do GitHub."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оптимизированная сборка, установленная командой make install или загруженная с GitHub."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บิลด์ที่ปรับให้เหมาะสม ตามที่ติดตั้งโดย make install หรือดาวน์โหลดจาก GitHub"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "make install ile yüklenen veya GitHub’dan indirilen, optimize edilmiş derleme."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оптимізована збірка, як установлена командою make install або завантажена з GitHub."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bản dựng đã tối ưu hóa, như bản được cài bằng make install hoặc tải về từ GitHub."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
