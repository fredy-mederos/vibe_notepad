    "You have version %@. Download the new one, open it and drag Vibe Notepad into Applications to replace this copy." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لديك الإصدار %@. نزّل الإصدار الجديد وافتحه واسحب Vibe Notepad إلى مجلد «التطبيقات» لاستبدال هذه النسخة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast Version %@. Lade die neue herunter, öffne sie und ziehe Vibe Notepad in „Programme“, um diese Kopie zu ersetzen."
          }
        },
        "es" : {
          "stringUnit" : {
