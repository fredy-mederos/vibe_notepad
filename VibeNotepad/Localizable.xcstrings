    "Pick a tab or a file, press ⌘P, or drag a tab here." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر علامة تبويب أو ملفًا، أو اضغط ⁦⌘P⁩، أو اسحب علامة تبويب إلى هنا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle einen Tab oder eine Datei, drücke ⌘P oder ziehe einen Tab hierher."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige una pestaña o un archivo, pulsa ⌘P o arrastra una pestaña hasta aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez un onglet ou un fichier, appuyez sur ⌘P ou faites glisser un onglet ici."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई टैब या फ़ाइल चुनें, ⌘P दबाएँ, या किसी टैब को यहाँ खींचें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih tab atau berkas, tekan ⌘P, atau seret tab ke sini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli una scheda o un file, premi ⌘P oppure trascina qui una scheda."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タブまたはファイルを選ぶか、⌘Pを押すか、タブをここにドラッグしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "탭이나 파일을 선택하거나, ⌘P를 누르거나, 탭을 여기로 끌어다 놓으세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih tab atau fail, tekan ⌘P atau seret tab ke sini."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies een tabblad of een bestand, druk op ⌘P of sleep een tabblad hierheen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz kartę lub plik, naciśnij ⌘P albo przeciągnij tutaj kartę."
          }
        },
        "pt-BR" : {
