    "Saving replaces those changes with the text in this tab." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيستبدل الحفظ تلك التغييرات بالنص الموجود في علامة التبويب هذه."
          }
        },
        "de" : {
          "stringUnit" : {
