{
  "sourceLanguage" : "en",
  "strings" : {
    "%@\nClick to copy the XPath, hold for more" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⁦%@⁩\nانقر لنسخ XPath، أو اضغط مطولًا لعرض المزيد"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nKlicke, um den XPath zu kopieren; halte gedrückt für mehr"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nHaz clic para copiar el XPath; mantén pulsado para ver más"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nCliquez pour copier le XPath, maintenez pour plus d’options"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nXPath कॉपी करने के लिए क्लिक करें, अधिक विकल्पों के लिए दबाए रखें"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nKlik untuk menyalin XPath, tahan untuk opsi lainnya"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nFai clic per copiare l’XPath, tieni premuto per altre opzioni"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nクリックでXPathをコピー、長押しでその他の項目を表示"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n클릭하여 XPath 복사, 길게 눌러 더 보기"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nKlik untuk menyalin XPath, tahan untuk pilihan lain"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nKlik om de XPath te kopiëren, houd ingedrukt voor meer"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nKliknij, aby skopiować XPath, przytrzymaj, aby zobaczyć więcej"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nClique para copiar o XPath; mantenha pressionado para ver mais"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nНажмите, чтобы скопировать XPath, или удерживайте, чтобы увидеть больше"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nคลิกเพื่อคัดลอก XPath กดค้างเพื่อดูเพิ่มเติม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nXPath’i kopyalamak için tıklayın, daha fazlası için basılı tutun"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nКлацніть, щоб скопіювати XPath; утримуйте, щоб побачити більше"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nNhấp để sao chép XPath, nhấn giữ để xem thêm"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n点按以拷贝 XPath，按住可查看更多"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n按一下以拷貝 XPath，按住可顯示更多"
          }
        }
      }
