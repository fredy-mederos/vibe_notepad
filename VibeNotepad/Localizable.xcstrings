    "Sorted by %@, ascending. Click to show the rows in the file’s order" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مفروزة حسب %@ تصاعديًا. انقر لإظهار الصفوف بترتيب الملف"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sortiert nach %@, aufsteigend. Klicke, um die Zeilen in der Dateireihenfolge anzuzeigen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordenado por %@, ascendente. Haz clic para mostrar las filas en el orden del archivo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trié par %@, ordre croissant. Cliquez pour afficher les lignes dans l’ordre du fichier"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ के अनुसार आरोही क्रम में क्रमबद्ध। पंक्तियों को फ़ाइल के क्रम में दिखाने के लिए क्लिक करें"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diurutkan menurut %@, menaik. Klik untuk menampilkan baris sesuai urutan berkas"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordinato per %@, in ordine crescente. Fai clic per mostrare le righe nell’ordine del file"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」の昇順で並べ替え済み。クリックで行をファイルの順序で表示"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 기준 오름차순 정렬. 클릭하면 행을 파일 순서대로 표시"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diisih mengikut %@, menaik. Klik untuk menunjukkan baris mengikut susunan fail"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesorteerd op %@, oplopend. Klik om de rijen in de volgorde van het bestand te tonen"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posortowano według: %@, rosnąco. Kliknij, aby pokazać wiersze w kolejności z pliku"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordenado por %@, crescente. Clique para mostrar as linhas na ordem do arquivo"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отсортировано по столбцу «%@», по возрастанию. Нажмите, чтобы показать строки в порядке файла"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เรียงตาม %@ จากน้อยไปมาก คลิกเพื่อแสดงแถวตามลำดับในไฟล์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sıralama: %@, artan. Satırları dosyadaki sırayla göstermek için tıklayın"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відсортовано за %@ (за зростанням). Клацніть, щоб показати рядки в порядку файлу"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã sắp xếp theo %@, tăng dần. Nhấp để hiển thị các hàng theo thứ tự trong tệp"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按“%@”升序排序。点按可按文件中的顺序显示各行"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "依 %@ 遞增排序。按一下以依檔案順序顯示列"
          }
        }
      }
    },
