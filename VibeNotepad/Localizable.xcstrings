    "Your changes will be lost if you don’t save them." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستفقد تغييراتك إذا لم تحفظها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Änderungen gehen verloren, wenn du sie nicht sicherst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus cambios se perderán si no los guardas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos modifications seront perdues si vous ne les enregistrez pas."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यदि आप बदलावों को नहीं सहेजते हैं, तो वे खो जाएँगे।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perubahan Anda akan hilang jika Anda tidak menyimpannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se non salvi, le modifiche andranno perse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存しない場合、変更内容は失われます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장하지 않으면 변경 사항이 사라집니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
