    "The text contains characters that %@ can’t represent. Save it as UTF-8 instead?" : {
      "comment" : "The placeholder is a text encoding",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتوي النص على أحرف لا يمكن تمثيلها بترميز %@. هل تريد حفظه بترميز UTF-8 بدلًا من ذلك؟"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Text enthält Zeichen, die %@ nicht darstellen kann. Stattdessen als UTF-8 sichern?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El texto contiene caracteres que %@ no puede representar. ¿Quieres guardarlo como UTF-8?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le texte contient des caractères que %@ ne peut pas représenter. L’enregistrer plutôt en UTF-8 ?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "टेक्स्ट में ऐसे वर्ण हैं जिन्हें %@ में दर्शाया नहीं जा सकता। इसके बजाय UTF-8 के रूप में सहेजें?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teks berisi karakter yang tidak dapat diwakili oleh %@. Simpan sebagai UTF-8?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il testo contiene caratteri che %@ non può rappresentare. Vuoi salvarlo come UTF-8?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テキストには%@で表現できない文字が含まれています。代わりにUTF-8で保存しますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "텍스트에 %@ 인코딩으로 표현할 수 없는 문자가 포함되어 있습니다. 대신 UTF-8로 저장하시겠습니까?"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teks mengandungi aksara yang tidak dapat diwakili oleh %@. Simpan sebagai UTF-8 sebaliknya?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De tekst bevat tekens die %@ niet kan weergeven. Wil je de tekst in plaats daarvan als UTF-8 bewaren?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekst zawiera znaki, których nie można przedstawić w kodowaniu %@. Zachować go jako UTF-8?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O texto contém caracteres que a codificação %@ não consegue representar. Deseja salvar como UTF-8?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Текст содержит символы, которые нельзя представить в кодировке %@. Сохранить его в UTF-8?"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ข้อความมีอักขระที่ %@ ไม่รองรับ ต้องการบันทึกเป็น UTF-8 แทนหรือไม่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metin, %@ ile gösterilemeyen karakterler içeriyor. Bunun yerine UTF-8 olarak kaydedilsin mi?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Текст містить символи, яких не підтримує кодування %@. Зберегти як UTF-8?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Văn bản có chứa các ký tự mà %@ không thể biểu diễn. Bạn có muốn lưu dưới dạng UTF-8 không?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文本包含 %@ 无法表示的字符。要改用 UTF-8 保存吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文字中包含 %@ 無法表示的字元。要改以 UTF-8 儲存嗎？"
          }
        }
      }
    },
